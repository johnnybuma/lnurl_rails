<div id="d3-chart-container" style="width:100%; min-height:420px;" data-chart-data="<%= ERB::Util.html_escape((@chart_data || []).to_json) %>">
  <% if @chart_data.blank? %>
    <p class="text-muted mb-0">No block history in this range yet. Run <code>save_all_blocks.rb</code> to backfill, or widen the range after data exists.</p>
  <% end %>
</div>

<script>
  (function () {
    function drawBlockChart(root) {
      if (typeof d3 === "undefined") return;

      var container = root.querySelector
        ? root.querySelector("#d3-chart-container") || root
        : document.getElementById("d3-chart-container");
      if (!container) return;

      var raw = container.getAttribute("data-chart-data") || "[]";
      var chartData;
      try {
        chartData = JSON.parse(raw);
      } catch (e) {
        chartData = [];
      }

      // Clear previous SVG
      d3.select(container).selectAll("svg").remove();

      var loading = document.getElementById("loadingIndicator");
      if (loading) loading.style.display = "none";

      if (!chartData.length) return;

      var margin = { top: 20, right: 160, bottom: 40, left: 60 };
      var width = Math.max(320, (container.clientWidth || 960) - margin.left - margin.right);
      var height = 420 - margin.top - margin.bottom;

      var svg = d3.select(container)
        .append("svg")
        .attr("width", width + margin.left + margin.right)
        .attr("height", height + margin.top + margin.bottom)
        .append("g")
        .attr("transform", "translate(" + margin.left + "," + margin.top + ")");

      var x = d3.scaleLinear()
        .domain(d3.extent(chartData, function (d) { return d[0]; }))
        .range([0, width]);
      svg.append("g")
        .attr("transform", "translate(0," + height + ")")
        .call(d3.axisBottom(x));

      var y1 = d3.scaleLinear()
        .domain([0, d3.max(chartData, function (d) { return d[1]; }) || 1])
        .range([height, 0]);
      svg.append("g").call(d3.axisLeft(y1));

      var y2 = d3.scaleLinear()
        .domain([0, d3.max(chartData, function (d) { return d[2]; }) || 1])
        .range([height, 0]);
      svg.append("g")
        .attr("transform", "translate(" + width + ",0)")
        .call(d3.axisRight(y2));

      var y3 = d3.scaleLinear()
        .domain([0, d3.max(chartData, function (d) { return d[3]; }) || 1])
        .range([height, 0]);
      svg.append("g")
        .attr("transform", "translate(" + (width + margin.right / 2) + ",0)")
        .call(d3.axisRight(y3));

      var line1 = d3.line().x(function (d) { return x(d[0]); }).y(function (d) { return y1(d[1]); });
      var line2 = d3.line().x(function (d) { return x(d[0]); }).y(function (d) { return y2(d[2]); });
      var line3 = d3.line().x(function (d) { return x(d[0]); }).y(function (d) { return y3(d[3]); });

      svg.append("path").datum(chartData).attr("fill", "none").style("stroke", "blue").attr("d", line1);
      svg.append("path").datum(chartData).attr("fill", "none").style("stroke", "green").attr("d", line2);
      svg.append("path").datum(chartData).attr("fill", "none").style("stroke", "red").attr("d", line3);
    }

    function onReady() {
      drawBlockChart(document);
    }

    document.addEventListener("DOMContentLoaded", onReady);
    document.addEventListener("turbo:load", onReady);
    document.addEventListener("turbo:frame-load", function (event) {
      if (event.target && event.target.id === "block_chart") {
        drawBlockChart(event.target);
      }
    });

    // Immediate draw when this partial is injected into a frame
    if (document.readyState !== "loading") {
      onReady();
    }
  })();
</script>
