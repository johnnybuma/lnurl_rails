<div id="raw_transaction_details_wrapper">
  <% if @rpc_error.present? %>
    <div class="alert alert-danger mb-0"><%= @rpc_error %></div>
  <% elsif transaction.blank? || (transaction.respond_to?(:empty?) && transaction.empty?) %>
    <p class="text-muted mb-0">No transaction loaded.</p>
  <% else %>
    <% if transaction["txid"].present? %>
      <p class="small font-monospace text-break mb-2">
        <strong>txid:</strong> <%= transaction["txid"] %>
      </p>
    <% end %>
    <div class="table-responsive" style="max-height: 480px; overflow: auto;">
      <table class="table table-sm mb-0">
        <thead class="table-light sticky-top">
          <tr>
            <th scope="col">Field</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <% transaction.each do |key, value| %>
            <% if key.to_s == "vin" && value.is_a?(Array) %>
              <% value.each_with_index do |item, item_index| %>
                <tr>
                  <td>Input <%= item_index + 1 %></td>
                  <td class="small"><%= render "transaction_item", item: item.is_a?(Hash) ? item : { "value" => item } %></td>
                </tr>
              <% end %>
            <% elsif key.to_s == "vout" && value.is_a?(Array) %>
              <% value.each_with_index do |item, item_index| %>
                <tr>
                  <td>Output <%= item_index + 1 %></td>
                  <td class="small"><%= render "transaction_item", item: item.is_a?(Hash) ? item : { "value" => item } %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td><%= key.to_s.humanize %></td>
                <td class="small text-break font-monospace">
                  <%= value.is_a?(Hash) || value.is_a?(Array) ? value.to_json : value %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
