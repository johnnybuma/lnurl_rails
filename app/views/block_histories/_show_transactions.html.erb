<div id="transaction-content">
  <% if @missing_block %>
    <div class="alert alert-warning mb-3">
      No stored <code>BlockHistory</code> for block <strong><%= @block_number %></strong>.
    </div>
  <% elsif @block_number.blank? %>
    <p class="text-muted mb-0">Enter a block number to load transactions.</p>
  <% else %>
    <p class="small text-muted mb-2">
      Block <strong><%= @block_number %></strong>
      · <%= pluralize(@transactions.size, "transaction") %>
    </p>
  <% end %>

  <% if @transactions.any? %>
    <div class="table-responsive" style="max-height: 480px; overflow: auto;">
      <table class="table table-sm table-striped mb-0">
        <thead class="table-light sticky-top">
          <tr>
            <th>#</th>
            <th>Transaction ID</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each_with_index do |tx, index| %>
            <% txid = tx.is_a?(Hash) ? (tx["txid"] || tx[:txid]) : tx.to_s %>
            <tr>
              <td><%= index %></td>
              <td class="font-monospace small text-break"><%= txid %></td>
              <td>
                <%= link_to "View details",
                            lookup_raw_transaction_path(tx_id: txid),
                            class: "btn btn-sm btn-outline-primary",
                            data: { turbo: false } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif !@missing_block && @block_number.present? %>
    <p class="text-muted mb-0">No transactions in stored block data.</p>
  <% end %>
</div>
