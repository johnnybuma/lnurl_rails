<div class="container-fluid mt-4">
  <h1 class="h3 mb-3">Bitcoin RPC Explorer</h1>
  <hr>

  <%= turbo_stream_from "chain_data_channel" %>

  <div id="chain_data" class="mb-4">
    <%= render "chain_data", chain_data: @chain_data %>
  </div>

  <% if @block_count.present? %>
    <p class="text-muted small">Block count: <strong><%= @block_count %></strong></p>
  <% end %>
</div>
