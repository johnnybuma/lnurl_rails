<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Chain datum #<%= @chain_datum.id %></h1>
    <%= link_to "← Index", chain_data_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
  <div id="chain_datum_panel" class="border rounded p-3 bg-white">
    <% if notice.present? %>
      <p class="text-success"><%= notice %></p>
    <% end %>

    <%= render @chain_datum %>

    <div class="d-flex flex-wrap gap-2 mt-3">
      <%= link_to "Edit", edit_chain_datum_path(@chain_datum), class: "btn btn-primary btn-sm" %>
      <%= link_to "New", new_chain_datum_path, class: "btn btn-outline-primary btn-sm" %>
      <%= button_to "Destroy", @chain_datum, method: :delete,
                    class: "btn btn-outline-danger btn-sm",
                    form: { data: { turbo_confirm: "Delete this chain datum?", turbo_stream: true } } %>
    </div>
  </div>
</div>
