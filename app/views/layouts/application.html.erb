<!DOCTYPE html>
<html>
  <head>
    <title>NodeView</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= favicon_link_tag 'SYMBOLIC.png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# Single module build: Turbo + Stimulus + Bootstrap + channels (do not double-include) %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>
  <body>
    <div class="container-fluid">
      <div class="row vh-100 overflow-auto">
        <%= render 'layouts/navigation' %>
        <div class="col d-flex flex-column h-sm-100" id="main-content">
          <main class="row overflow-auto">
            <div class="position-absolute top-0 start-30" style="z-index: 10001">
              <% if notice %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  <%= notice %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% end %>
              <% if alert %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <%= alert %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% end %>
            </div>
            <div class="main-padding">
              <%= yield %>
            </div>
          </main>
          <footer class="row bg-light py-4 mt-auto">
            <div class="col">Bitcoin RPC Explorer</div>
          </footer>
        </div>
      </div>
    </div>
  </body>
</html>
