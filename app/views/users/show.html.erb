<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">User</h1>
    <% if current_user.admin? %>
      <%= link_to "Back to Users", users_path, class: "btn btn-outline-secondary btn-sm" %>
    <% end %>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="d-flex align-items-center mb-3">
        <%= image_tag(@user.avatar, width: 64, height: 64, class: "rounded-circle me-3") if @user.avatar.attached? %>
        <div>
          <h2 class="h4 mb-1"><%= @user.username.presence || "—" %></h2>
          <div class="text-muted"><%= @user.email %></div>
        </div>
      </div>
      <dl class="row mb-0">
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9"><span class="badge text-bg-secondary"><%= @user.role %></span></dd>
      </dl>
    </div>
  </div>
</div>
