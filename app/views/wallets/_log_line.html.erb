<%
  # High-contrast colors for dark log backgrounds (#0d1117)
  css =
    case kind.to_sym
    when :ok then "color:#3fb950;"
    when :error then "color:#f85149;"
    else "color:#c9d1d9;"
    end
%>
<div class="small font-monospace border-bottom py-1" style="<%= css %> border-color:#30363d !important;">
  <span style="color:#8b949e;"><%= at.strftime("%H:%M:%S") %></span>
  <%= message %>
</div>
