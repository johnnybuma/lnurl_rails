<%# locals: wallet (Hash) — kept for any remaining card renders %>
<div class="card h-100 shadow-sm wallet-card" id="wallet_card_<%= wallet[:name].to_s.parameterize %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
      <h3 class="h6 mb-0 text-break">
        <%= link_to wallet[:name], wallet_path(wallet[:name]), class: "text-decoration-none" %>
      </h3>
      <% if wallet[:loaded] %>
        <span class="badge text-bg-success">loaded</span>
      <% else %>
        <span class="badge text-bg-secondary">on disk</span>
      <% end %>
    </div>

    <% if wallet[:error].present? %>
      <p class="small text-danger mb-2"><%= truncate(wallet[:error], length: 80) %></p>
    <% elsif wallet[:loaded] %>
      <dl class="row small mb-2">
        <dt class="col-5 text-muted">Balance</dt>
        <dd class="col-7 mb-1"><strong><%= wallet[:balance].nil? ? "—" : "#{wallet[:balance]} BTC" %></strong></dd>
        <dt class="col-5 text-muted">Tx count</dt>
        <dd class="col-7 mb-1"><%= wallet[:txcount].nil? ? "—" : wallet[:txcount] %></dd>
      </dl>
    <% else %>
      <p class="small text-muted mb-2">Not loaded. Open the wallet page to load it.</p>
    <% end %>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Open", wallet_path(wallet[:name]), class: "btn btn-sm btn-primary" %>
      <% unless wallet[:loaded] %>
        <%= button_to "Load", load_wallet_path(wallet[:name]), method: :post,
                      class: "btn btn-sm btn-outline-primary",
                      form: { data: { turbo: true, turbo_stream: true } } %>
      <% end %>
    </div>
  </div>
</div>
